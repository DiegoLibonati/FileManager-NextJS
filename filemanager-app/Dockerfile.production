FROM node:22-alpine3.19 AS builder

WORKDIR /home/app

COPY package*.json yarn.lock* ./
RUN yarn install --frozen-lockfile

COPY . .

RUN yarn build

FROM node:22-alpine3.19 AS production

WORKDIR /home/app

ENV NODE_ENV=production

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY --from=builder /home/app/.next/standalone ./
COPY --from=builder /home/app/.next/static ./.next/static
COPY --from=builder /home/app/public ./public

RUN mkdir -p /home/app/.next/cache $CLOUD_PATH \
    && chown -R appuser:appgroup /home/app

USER appuser

EXPOSE 3000

CMD ["node", "server.js"]
